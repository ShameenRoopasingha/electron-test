// -------------------------------------------------
// GENERATORS
// -------------------------------------------------
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
  emitJs = false
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// -------------------------------------------------
// DATASOURCE
// -------------------------------------------------


// -------------------------------------------------
// ENUMS
// -------------------------------------------------
enum Role {
  OWNER
  ADMIN
  CASHIER
  SELLER
}

// -------------------------------------------------
// BUSINESS DETAILS MODEL (One-to-One with OWNER)
// -------------------------------------------------
model BusinessDetails {
  id                 Int      @id @default(autoincrement())
  name               String
  registrationNumber String?
  address            String
  email              String?
  phone              String?
  logoUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerId Int    @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// USER MODEL
// -------------------------------------------------
model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  email        String            @unique
  password     String
  role         Role              @default(SELLER)
  fname        String
  lname        String
  phone        String            @unique
  address      String
  bank_account String            @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  bills        Bill[]
  sessions     UserSession[]
  expiredItems ExpiredItem[]
  restocks     Restock[]
  defects      Defect[]

  business     BusinessDetails?  // Only if role = OWNER
}

// -------------------------------------------------
// CUSTOMER MODEL
// -------------------------------------------------
model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  bills     Bill[]
}

// -------------------------------------------------
// SUPPLIER MODEL
// -------------------------------------------------
model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String    @unique
  company   String
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  items     Item[]
  restocks  Restock[]
}

// -------------------------------------------------
// CATEGORY MODEL
// -------------------------------------------------
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  items       Item[]
}

// -------------------------------------------------
// ITEM MODEL
// -------------------------------------------------
model Item {
  id              Int           @id @default(autoincrement())
  name            String
  categoryId      Int
  manufacturer    String
  supplierId      Int
  barcode         String        @unique
  costPrice       Float
  sellingPrice    Float
  quantityInStock Int
  reorder_level   Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())

  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  checkouts       Checkout[]
  returnedOrders  ReturnedOrder[]
  defects         Defect[]
  expiredItems    ExpiredItem[]
  restockItems    RestockItem[]
}

// -------------------------------------------------
// BILL MODEL
// -------------------------------------------------
model Bill {
  id            Int       @id @default(autoincrement())
  userId        Int
  customerId    Int
  totalAmount   Float
  paymentMethod String
  paymentStatus String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkouts     Checkout[]
  returnedOrders ReturnedOrder[]
}

// -------------------------------------------------
// CHECKOUT MODEL
// -------------------------------------------------
model Checkout {
  id          Int       @id @default(autoincrement())
  billId      Int
  itemId      Int
  quantity    Int
  price       Float
  payedAmount Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// RESTOCK MODEL
// -------------------------------------------------
model Restock {
  id         Int        @id @default(autoincrement())
  supplierId Int
  userId     Int
  totalCost  Float
  createdAt  DateTime   @default(now())

  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      RestockItem[]
}

// -------------------------------------------------
// RESTOCK ITEM MODEL
// -------------------------------------------------
model RestockItem {
  id        Int       @id @default(autoincrement())
  restockId Int
  itemId    Int?
  quantity  Int
  costPrice Float

  restock   Restock  @relation(fields: [restockId], references: [id], onDelete: Cascade)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// RETURNED ORDER MODEL
// -------------------------------------------------
model ReturnedOrder {
  id        Int       @id @default(autoincrement())
  billId    Int?
  itemId    Int?
  quantity  Int
  reason    String
  createdAt DateTime  @default(now())

  bill      Bill?     @relation(fields: [billId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// DEFECT MODEL
// -------------------------------------------------
model Defect {
  id         Int      @id @default(autoincrement())
  itemId     Int?
  quantity   Int
  reason     String
  reportedBy Int
  createdAt  DateTime @default(now())

  item       Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// EXPIRED ITEM MODEL
// -------------------------------------------------
model ExpiredItem {
  id             Int      @id @default(autoincrement())
  itemId         Int?
  quantity       Int
  expirationDate DateTime
  disposedBy     Int
  reason         String?
  createdAt      DateTime @default(now())

  item           Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [disposedBy], references: [id], onDelete: Cascade)
}

// -------------------------------------------------
// USER SESSION MODEL
// -------------------------------------------------
model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique
  ipAddress  String?
  deviceInfo String?
  loginTime  DateTime @default(now())
  logoutTime DateTime?
  isActive   Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
